{
  "name": "DirectChatMessageBroadcast",
  "namespace": "com.chatservice",
  "type": "record",
  "fields": [
    {
      "name": "fromUserEmail",
      "type": "string",
      "default": "anonymous"
    },
    {
      "name": "toUserEmail",
      "type": "string",
      "default": "anonymous"
    },
    {
      "name": "message",
      "type": "string"
    },
    {
      "name": "createdTime",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}